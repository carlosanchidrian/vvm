Screen {
    background: $surface;
    color: $text;
}

Header {
    background: $primary;
    color: $text;
}

Footer {
    background: $panel;
}

#profiles-title,
#precheck-title,
#session-title,
#report-title {
    content-align: center middle;
    text-style: bold;
    height: 3;
    padding: 1 2;
}

#profile-table,
#check-table {
    height: 1fr;
    border: round $primary;
    margin: 0 1;
}

#profiles-path,
#precheck-verdict,
#session-log,
#report-path {
    height: auto;
    min-height: 1;
    padding: 0 2;
    color: $text-muted;
}

#precheck-verdict {
    text-style: bold;
    padding: 1 2;
}

.session-panel {
    height: auto;
    min-height: 12;
    border: round $primary;
    padding: 1 2;
    margin: 0 1;
}

#report-scroll {
    height: 1fr;
    border: round $primary;
    margin: 0 1;
}

#report-view {
    width: 100%;
    padding: 1 2;
}

#form-scroll {
    height: 1fr;
    border: round $primary;
    margin: 0 1;
    padding: 1 2;
}

#form-scroll Label {
    margin-top: 1;
}

#form-scroll Input,
#form-scroll Select {
    width: 100%;
}

#form-buttons {
    height: auto;
    margin-top: 2;
}

#form-buttons Button {
    margin-right: 2;
}

#form-error {
    color: $error;
    height: auto;
    min-height: 1;
    margin-top: 1;
}

#delete-box {
    width: 70%;
    height: auto;
    border: round $error;
    padding: 2 3;
    margin: 4 10;
}

#delete-title {
    text-style: bold;
    height: auto;
    padding-bottom: 1;
}

#delete-text,
#delete-error {
    height: auto;
    min-height: 1;
}

#delete-error {
    color: $error;
}

#delete-buttons {
    height: auto;
    margin-top: 2;
}

#topbar {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#topbar-title {
    width: 1fr;
    height: 1;
    content-align: left middle;
}

#topbar Button {
    width: 3;
    min-width: 3;
    height: 1;
    min-height: 1;
    border: none;
    padding: 0;
    margin: 0 1 0 0;
    background: $primary;
    color: $text;
    content-align: center middle;
    text-style: bold;
}

#home {
    dock: left;
    color: #3b82f6;
}

#close-all {
    dock: right;
    color: $error;
}

#topbar Button:hover {
    background: $primary-lighten-2;
}

#topbar Button:focus {
    background: $primary-lighten-3;
    color: $text;
}

#empty-state {
    height: auto;
    min-height: 3;
    padding: 1 2;
    content-align: center middle;
    color: $text-muted;
}

#session-tabs {
    height: 1fr;
}

SessionTab {
    height: 1fr;
}

.session-header {
    height: auto;
    min-height: 1;
    padding: 0 1;
    text-style: bold;
}

.session-meta {
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $text-muted;
}

ConsoleView {
    height: 1fr;
    min-height: 8;
    border: round $primary;
    padding: 0 1;
}

ConsoleView.capturing {
    border: round $success;
}

.console-hint {
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $text-muted;
}

#vm-menu {
    width: 64;
    height: auto;
    border: round $primary;
    padding: 1 2;
    margin: 4 8;
}

#vm-menu-title {
    text-style: bold;
    height: auto;
    padding-bottom: 1;
}

#vm-menu-options {
    height: auto;
}

#close-all-box {
    width: 64;
    height: auto;
    border: round $error;
    padding: 2 3;
    margin: 4 8;
}

#close-all-title {
    text-style: bold;
    height: auto;
    padding-bottom: 1;
}

#close-all-text {
    height: auto;
    padding-bottom: 1;
}

#close-all-buttons {
    height: auto;
    margin-top: 1;
}

ProfilePickerScreen {
    align: center middle;
    background: $background 35%;
}

#picker-box {
    width: 72;
    height: auto;
    max-height: 20;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#picker-title {
    height: 1;
    text-style: bold;
}

#picker-sub {
    height: 1;
    color: $text-muted;
}

#picker-table {
    height: 10;
    margin-top: 1;
}

#picker-hint {
    height: 1;
    margin-top: 1;
    color: $text-muted;
}
